# Copy this file to .env and fill in what you use. .env is gitignored —
# never commit real keys. rvnxc.sh sources .env automatically if present.

# GitHub token for OSINT / github-subdomains / gitleaks-on-org-repos
GITHUB_TOKEN=

# ProjectDiscovery Cloud Platform key (optional — asnmap/uncover features)
PDCP_API_KEY=

# Shodan (optional passive port/service data)
SHODAN_API_KEY=

# WHOISXML (optional richer WHOIS)
WHOISXML_API=

# Notifications — set NOTIFICATION=true in rvnxc.cfg to enable
DISCORD_WEBHOOK=
SLACK_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
